<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MiniFigs.Models"
             x:Class="MiniFigs.MainPage">

    <Grid RowDefinitions="*, auto">
        <RefreshView x:Name="refreshView">
            <CollectionView x:Name="charactersCollectionView" SelectionChanged="SelectionChanged_Event" Margin="5">
                <CollectionView.EmptyView>
                    <Grid>
                        <Label Text="Geen data om weer te geven" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MiniFig">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem 
                IconImageSource="star.svg"
                Invoked="OnFavoriteSwipeItemInvoked" CommandParameter="{Binding Name}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <Border StrokeThickness="1" Stroke="Black" Margin="2" Padding="2">
                                <Grid ColumnDefinitions="auto,*" RowDefinitions="*,*" Margin="10" Padding="5">
                                    <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Source="{Binding ImageUrl}" HeightRequest="60"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Race}" FontSize="Small" FontAttributes="Italic"/>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Label Text="Last refresh @ ..." x:Name="refreshLabel" HorizontalTextAlignment="Center" FontSize="Large" TextColor="LightGray"></Label>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <VerticalStackLayout Spacing="15" Margin="2" Padding="20" Grid.Row="1">
            <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="2"/>
            <Button Text="Load data" Clicked="OnLoadDataClicked"/>
            <Button Text="Change selection mode" Clicked="OnChangeSelectionModeClicked"/>
            <Label Text="" x:Name="selectionLabel" FontSize="Medium" TextColor="Orange"/>
            <Label Text="" x:Name="favouriteLabel" FontSize="Medium" TextColor="Green"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
